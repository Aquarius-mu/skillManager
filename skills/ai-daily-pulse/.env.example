# AI Daily Pulse - 环境变量示例
# 与 ~/.config/ai-daily-pulse/config.json 等价,环境变量优先级更高
# 全部可选——任意一个 App ID/Secret 缺失时,Skill 自动回退到 stdout Markdown 输出

# 飞书自建应用凭证
FEISHU_APP_ID=cli_xxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 默认推送目标群(可被 --chat-id 或 FEISHU_SOURCE_CHAT_ID 覆盖)
FEISHU_DEFAULT_CHAT_ID=oc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 运行时注入(可选): 触发指令的群 chat_id,实现"哪里触发推哪里"
# FEISHU_SOURCE_CHAT_ID=
